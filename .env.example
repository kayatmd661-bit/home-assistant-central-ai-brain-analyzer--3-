# Environment Variables for Auto-Evolving Edge-AI Master Hub for Home Assistant

# Google Gemini API Key (Required for cloud-assisted AI features, intent reasoning, and live voice)
GEMINI_API_KEY=

# Home Assistant URL (Default: http://homeassistant.local:8123)
HA_URL=

# Home Assistant Long-Lived Access Token (Optional: Used to communicate directly with your HA instance)
HA_TOKEN=

# Supervisor Token (Optional: Automatically provided in HAOS Addon environments)
SUPERVISOR_TOKEN=

# Hassio Ingress Token (Optional: Provided by HAOS supervisor ingress)
HASSIO_TOKEN=
